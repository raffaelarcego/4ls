generator client {
  provider      = "prisma-client-js"
  // "native" cobre a maquina de desenvolvimento; o segundo alvo e o runtime
  // Linux da Vercel. Sem ele o deploy sobe sem o engine certo e toda query
  // falha em producao, mesmo com o build passando.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime usa a conexao com pooler (PgBouncer) do Neon.
  url       = env("DATABASE_URL")
  // Migrations precisam de uma conexao direta: o PgBouncer nao suporta
  // os comandos de DDL em sessao que o Prisma Migrate emite.
  directUrl = env("DIRECT_DATABASE_URL")
}

// =========================== Nucleo ===========================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  dailyMinutes Int      @default(60)
  timezone     String   @default("America/Sao_Paulo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userLanguages    UserLanguage[]
  userVocabulary   UserVocabulary[]
  studySessions    StudySession[]
  errors           ErrorRecord[]
  assessments      Assessment[]
  conversations    Conversation[]
  userAchievements UserAchievement[]
  grammarProgress  GrammarProgress[]
  conceptProgress  ConceptProgress[]
  streak           Streak?
  aiCalls          AiCallLog[]

  @@map("users")
}

model Language {
  id   String @id @default(uuid())
  code String @unique // en | es | de | ru
  name String
  flag String @default("")

  userLanguages UserLanguage[]
  vocabulary    Vocabulary[]
  lessons       Lesson[]
  activities    Activity[]
  errors        ErrorRecord[]  @relation("ErrorLanguage")
  interferences ErrorRecord[]  @relation("ErrorSourceLanguage")
  assessments   Assessment[]
  conversations Conversation[]

  @@map("languages")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model UserLanguage {
  id            String    @id @default(uuid())
  userId        String
  languageId    String
  currentLevel  CefrLevel @default(A1)
  targetLevel   CefrLevel @default(B1)
  priority      Int       @default(1)
  minutesPerDay Int       @default(20)

  // subcompetencias CEFR (0-100)
  listening     Float @default(0)
  reading       Float @default(0)
  writing       Float @default(0)
  speaking      Float @default(0)
  vocabScore    Float @default(0)
  grammar       Float @default(0)
  pronunciation Float @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId])
  @@map("user_languages")
}

// =========================== Vocabulario + SRS ===========================

model Vocabulary {
  id          String    @id @default(uuid())
  languageId  String
  /**
   * O conceito que este termo realiza neste idioma.
   * E o que amarra "work", "trabajo", "Arbeit" e "rabota" na mesma linha: o
   * aluno nunca aprende uma palavra solta, aprende um significado em todos os
   * idiomas que ele estuda. Opcional porque termo criado a mao pode chegar
   * antes de existir conceito -- o ConceptsService fecha a lacuna depois.
   */
  conceptId   String?
  term        String
  meaning     String
  example     String?
  translation String?
  level       CefrLevel @default(A1)
  difficulty  Int       @default(3) // 1-5
  source      String    @default("seed")
  createdAt   DateTime  @default(now())

  language Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)
  concept  Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  users    UserVocabulary[]

  @@unique([languageId, term])
  @@index([conceptId])
  @@map("vocabulary")
}

/**
 * Um significado, independente de idioma.
 * O produto deixou de ensinar palavras para passar a ensinar conceitos: o que
 * entra na sessao de hoje e "trabalho", e ele chega ao aluno simultaneamente
 * em ingles, espanhol, alemao e russo. Isso e o que faz a memoria de um idioma
 * sustentar a dos outros -- lembrar de "Arbeit" fica mais facil quando ela
 * entrou junto com "work", "trabajo" e "rabota", pendurada no mesmo gancho.
 * O slug e em portugues porque a lingua materna e o indice natural do aluno.
 */
model Concept {
  id        String    @id @default(uuid())
  /**
   * Chave estavel em portugues, ex.: "trabalho".
   */
  slug      String    @unique
  /**
   * Como o conceito se le em portugues, ex.: "o trabalho".
   */
  gloss     String
  /**
   * Uma frase em portugues que situa o uso; vira base dos exemplos.
   */
  note      String?
  level     CefrLevel @default(A1)
  source    String    @default("seed")
  createdAt DateTime  @default(now())

  entries  Vocabulary[]
  progress ConceptProgress[]

  @@map("concepts")
}

/**
 * O que o aluno sabe sobre um CONCEITO, acima das formas.
 * O SRS por card ja mede cada palavra em cada idioma, e continua medindo. Mas
 * ele nao consegue distinguir duas falhas muito diferentes:
 * - "nao sei o que isso significa" -- o conceito nao entrou;
 * - "sei o significado, nao consigo puxar a forma russa" -- o conceito
 * entrou, a forma nao.
 * Sao problemas opostos. O primeiro pede reensinar o conceito; o segundo pede
 * so treino de recuperacao naquele idioma, e reapresentar o significado ali e
 * desperdicio. Esta tabela e a camada que separa os dois: `meaningStrength`
 * mede o conceito atraves de TODOS os idiomas, e e o que autoriza a revisao a
 * mostrar a palavra que o aluno ja domina como andaime da que ele ainda erra.
 */
model ConceptProgress {
  id        String @id @default(uuid())
  userId    String
  conceptId String

  /**
   * 0-1, media movel dos acertos do conceito em QUALQUER idioma.
   * Alto com um card fraco significa: o significado esta la, falta a forma.
   */
  meaningStrength Float @default(0)
  reviews         Int   @default(0)
  correct         Int   @default(0)

  /**
   * Idioma em que o conceito foi recuperado com mais folga -- o candidato
   * natural a andaime. Guardado em vez de calculado a cada revisao porque a
   * consulta seria um join por card em toda listagem de revisao vencida.
   */
  anchorLanguageId String?

  firstLearnedAt DateTime @default(now())
  lastReviewAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, meaningStrength])
  @@map("concept_progress")
}

enum VocabStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

model UserVocabulary {
  id           String      @id @default(uuid())
  userId       String
  vocabularyId String
  status       VocabStatus @default(NEW)
  confidence   Float       @default(0) // 0-1
  easeFactor   Float       @default(2.5)
  intervalDays Int         @default(0)
  repetitions  Int         @default(0)
  lastReview   DateTime?
  nextReview   DateTime    @default(now())
  correctCount Int         @default(0)
  wrongCount   Int         @default(0)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, nextReview])
  @@map("user_vocabulary")
}

// =========================== Conteudo ===========================

enum Pillar {
  LISTEN
  LEARN
  LIVE
  LEVEL_UP
}

model Lesson {
  id         String    @id @default(uuid())
  languageId String
  title      String
  level      CefrLevel @default(A1)
  pillar     Pillar    @default(LEARN)
  type       String // vocabulary | grammar | dialogue | listening | reading
  content    Json
  minutes    Int       @default(5)
  createdAt  DateTime  @default(now())

  language   Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("lessons")
}

// =========================== Sessoes de estudo ===========================

model StudySession {
  id              String    @id @default(uuid())
  userId          String
  date            DateTime  @default(now())
  plannedMinutes  Int       @default(60)
  durationSeconds Int       @default(0)
  xpEarned        Int       @default(0)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  plan            Json? // snapshot do Daily Mission Engine
  rationale       String? // por que esta sessao

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([userId, date])
  @@map("study_sessions")
}

model Activity {
  id              String   @id @default(uuid())
  sessionId       String
  languageId      String
  lessonId        String?
  pillar          Pillar
  type            String
  order           Int      @default(0)
  plannedMinutes  Int      @default(5)
  durationSeconds Int      @default(0)
  score           Float? // 0-100
  xpEarned        Int      @default(0)
  completed       Boolean  @default(false)
  payload         Json?
  reason          String? // por que foi recomendada
  createdAt       DateTime @default(now())

  session  StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  language Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)
  lesson   Lesson?      @relation(fields: [lessonId], references: [id])

  @@index([sessionId])
  @@map("activities")
}

// =========================== Error Intelligence ===========================

enum ErrorCategory {
  VOCABULARY
  GRAMMAR
  PRONUNCIATION
  WORD_ORDER
  ARTICLE
  TENSE
  PREPOSITION
  FALSE_COGNATE
  SPELLING
  COMPREHENSION
}

model ErrorRecord {
  id               String        @id @default(uuid())
  userId           String
  languageId       String
  /**
   * De qual OUTRO idioma veio a interferencia, quando o erro foi causado por
   * ela.
   * E o campo que separa este produto de um app de idioma solto. Quem estuda
   * quatro linguas ao mesmo tempo quase nunca erra por ignorancia -- erra por
   * importar a regra da lingua vizinha: ordem russa numa frase alema,
   * "oficina" achando que e espanhol, "I have thirty years" vindo do
   * portugues. Sem registrar a ORIGEM, todos esses viram "erro de gramatica" e
   * o dado mais util do perfil se perde.
   * Nulo quando o erro nao veio de interferencia (ou quando nao deu para
   * dizer): a maioria dos erros e assim, e forcar uma origem seria inventar.
   */
  sourceLanguageId String?
  category         ErrorCategory
  description      String
  userText         String?
  correctedText    String?
  explanation      String?
  source           String        @default("tutor") // tutor | writing | speaking | review
  severity         Int           @default(2) // 1-3
  occurrenceCount  Int           @default(1)
  lastOccurrence   DateTime      @default(now())
  resolved         Boolean       @default(false)
  createdAt        DateTime      @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language       Language  @relation("ErrorLanguage", fields: [languageId], references: [id], onDelete: Cascade)
  sourceLanguage Language? @relation("ErrorSourceLanguage", fields: [sourceLanguageId], references: [id], onDelete: SetNull)

  @@index([userId, languageId, resolved])
  @@index([userId, sourceLanguageId])
  @@map("errors")
}

// =========================== Avaliacao ===========================

model Assessment {
  id             String    @id @default(uuid())
  userId         String
  languageId     String
  skill          String // listening | reading | writing | speaking | grammar | vocabulary
  score          Float
  estimatedLevel CefrLevel
  detail         Json?
  createdAt      DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

// =========================== Tutor ===========================

model Conversation {
  id         String    @id @default(uuid())
  userId     String
  languageId String
  title      String    @default("Nova conversa")
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, languageId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  correction     Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// =========================== Gamificacao ===========================

model Streak {
  id            String    @id @default(uuid())
  userId        String    @unique
  current       Int       @default(0)
  longest       Int       @default(0)
  lastActiveDay DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Achievement {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String
  xp          Int    @default(0)
  icon        String @default("*")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// =========================== Observabilidade de IA ===========================

model AiCallLog {
  id            String   @id @default(uuid())
  userId        String?
  provider      String
  model         String
  task          String
  language      String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  latencyMs     Int      @default(0)
  success       Boolean  @default(true)
  error         String?
  estimatedCost Float    @default(0)
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("ai_call_logs")
}

// =========================== Fala ===========================

/**
 * Cache de audio sintetizado. A chave e o hash de (texto + idioma + voz), nao
 * o id de um termo: a mesma frase dita no mesmo idioma custa uma unica
 * sintetizacao para sempre, venha ela do flashcard, do listening ou do tutor.
 */
model SpeechClip {
  id           String   @id @default(uuid())
  hash         String   @unique
  languageCode String
  voice        String
  text         String
  mimeType     String   @default("audio/mpeg")
  data         Bytes
  bytes        Int      @default(0)
  provider     String
  model        String
  playCount    Int      @default(0)
  createdAt    DateTime @default(now())
  lastPlayedAt DateTime @default(now())

  @@index([languageCode])
  @@map("speech_clips")
}

/**
 * Dialogos de listening ja gerados.
 * O cache de audio (speech_clips) so ajuda se o texto se repetir. Como cada
 * bloco de escuta gerava um dialogo novo, o texto nunca repetia e a sintese
 * era sempre paga -- justamente no conteudo mais caro. Guardando os dialogos
 * num pool por idioma e nivel, o custo cai a zero depois que o pool enche: o
 * texto vem daqui e o audio ja esta em cache.
 */
model ListeningDialogue {
  id           String   @id @default(uuid())
  languageCode String
  level        String
  title        String
  context      String
  lines        Json
  questions    Json
  vocabulary   Json?
  timesUsed    Int      @default(0)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([languageCode, level])
  @@map("listening_dialogues")
}

// =========================== Gramatica contrastiva ===========================

/**
 * Progresso do aluno em um contraste gramatical, por idioma ALVO.
 * A chave e (usuario, topico, idioma): "ordem das palavras" estudada para o
 * alemao e um progresso diferente de "ordem das palavras" para o ingles --
 * sao regras distintas, ainda que o topico do catalogo seja o mesmo.
 * O topico nao e uma FK: o catalogo vive no codigo (contrast-catalog.ts), nao
 * no banco. Guardar o id como string evita ter de migrar o banco toda vez que
 * um contraste novo e escrito.
 */
model GrammarProgress {
  id            String   @id @default(uuid())
  userId        String
  topicId       String
  languageCode  String
  /**
   * 0-100, media movel dos acertos: mede se o ponto firmou.
   */
  mastery       Float    @default(0)
  attempts      Int      @default(0)
  correct       Int      @default(0)
  /**
   * Marcado pelo aluno como "isso ainda me confunde".
   */
  flagged       Boolean  @default(false)
  lastStudiedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, languageCode])
  @@index([userId, languageCode])
  @@map("grammar_progress")
}

/**
 * Exercicios de contraste ja gerados, guardados por (topico, idioma, nivel).
 * Mesma logica do pool de dialogos de listening: gerar um conjunto novo a cada
 * abertura de topico pagaria a IA para sempre. Com o pool, depois que ele
 * enche o custo vai a zero e o aluno ainda ve variacao suficiente para nao
 * decorar a ordem das respostas.
 */
model GrammarDrillSet {
  id           String   @id @default(uuid())
  topicId      String
  languageCode String
  level        String
  drills       Json
  timesUsed    Int      @default(0)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([topicId, languageCode, level])
  @@map("grammar_drill_sets")
}

// =========================== Formacao de frase ===========================

/**
 * Aula de formacao de frase, guardada por (idioma, nivel).
 * Saber o significado de "Arbeit" nao ensina a dizer "eu vou para o trabalho
 * amanha de manha": cada idioma monta a frase com uma ordem, uma marcacao e
 * umas obrigacoes proprias. Esta tabela guarda essas aulas -- formula, passos,
 * exemplos desmontados peca a peca e exercicios -- pela mesma razao dos pools
 * de listening e de drills: gerar de novo a cada sessao pagaria a IA para
 * sempre, e o conteudo de estrutura e justamente o que mais se repete.
 */
model SentencePattern {
  id           String   @id @default(uuid())
  languageCode String
  level        String
  /**
   * Identificador do padrao, ex.: "ordem-basica". Estavel entre geracoes.
   */
  patternId    String
  title        String
  /**
   * A duvida do aluno, escrita como ele a formularia.
   */
  question     String
  /**
   * A regra em uma linha, ex.: "Sujeito + verbo (2a posicao) + resto".
   */
  formula      String
  explanation  String
  /**
   * Passos de montagem da frase, em portugues.
   */
  steps        Json
  /**
   * Frases exemplo ja desmontadas em constituintes.
   */
  examples     Json
  /**
   * Erros que um brasileiro comete neste padrao.
   */
  pitfalls     Json
  /**
   * Exercicios de montagem, corrigiveis sem IA.
   */
  drills       Json
  timesUsed    Int      @default(0)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([languageCode, level])
  @@index([languageCode, patternId])
  @@map("sentence_patterns")
}

// ============================== Morfologia (casos) ==============================

/**
 * O paradigma de UMA palavra: ela escrita em todos os casos do idioma.
 *
 * O bloco de estrutura ensina a ordem das pecas e o de vocabulario ensina o
 * significado; nenhum dos dois ensina que a palavra MUDA DE FORMA conforme a
 * funcao -- e em alemao e russo ela muda em toda frase.
 *
 * A palavra vem do vocabulario do proprio aluno, e nao de uma lista de exemplo:
 * declinar "стол" para quem nunca viu "стол" ensina duas coisas ao mesmo tempo,
 * e a terminacao e a que se perde.
 *
 * Os exemplos guardados junto sao o que torna o exercicio corrigivel sem IA: a
 * frase tem a palavra num caso, e os distratores sao as OUTRAS formas da mesma
 * tabela -- os concorrentes certos, de graca.
 */
model MorphologyParadigm {
  id           String  @id @default(uuid())
  languageCode String
  /**
   * O conceito por tras da palavra, quando ela veio de um. Opcional porque
   * termo criado a mao pode nao ter conceito.
   */
  conceptId    String?
  /**
   * A forma do dicionario. Chave da palavra dentro do idioma.
   */
  term         String
  /**
   * Como ela se le em portugues, ex.: "o trabalho".
   */
  gloss        String
  /**
   * O genero, quando o idioma tem. Decide metade das terminacoes.
   */
  gender       String?
  /**
   * O padrao de declinacao, em portugues, ex.: "feminino em -a".
   */
  pattern      String
  /**
   * Uma entrada por caso: forma, romanizacao e o que reparar nela.
   */
  forms        Json
  /**
   * Frases de exemplo, uma por caso, com a palavra ja flexionada e o pedaco
   * exato que sera escondido no exercicio.
   */
  examples     Json

  timesUsed  Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([languageCode, term])
  @@index([languageCode])
  @@map("morphology_paradigms")
}

// ========================== Leitura paralela (4 idiomas) ==========================

/**
 * A MESMA historia, escrita nos quatro idiomas e alinhada frase a frase.
 *
 * Nao e uma tabela por idioma, pela mesma razao da `CanDoLesson`: o texto nao
 * pertence a idioma nenhum -- ele existe no espaco entre os quatro. Quebra-lo
 * em quatro linhas perderia o unico dado que importa, que e o de as quatro
 * versoes serem a mesma historia, com a frase N dizendo a mesma coisa em todas.
 *
 * O aluno le primeiro no idioma mais forte. Quando o texto voltar em russo, ele
 * ja sabe o que esta escrito ali, e e isso que o deixa ler acima do proprio
 * nivel sem travar na terceira linha -- o mesmo andaime da revisao, aplicado a
 * texto.
 *
 * Gerada fora do horario de estudo, como todo pool: sao quatro versoes numa
 * resposta so, com cirilico dentro, e a funcao da Vercel morre aos 60s.
 */
model ReadingPassage {
  id       String @id @default(uuid())
  /**
   * Id do texto no catalogo do codigo, ex.: "a-manha-atrasada".
   */
  topicId  String
  /**
   * O nivel-teto do texto: o MENOR nivel entre os idiomas do aluno, porque a
   * mesma historia precisa ser legivel nos quatro. O que varia por idioma e o
   * tamanho da frase, e isso vive dentro de `versions`.
   */
  level    String
  /**
   * O titulo em portugues, do catalogo. Cada versao traz o seu.
   */
  title    String
  /**
   * As quatro versoes: cada uma com titulo, frases (texto, romanizacao,
   * traducao), glossario e perguntas de compreensao no proprio idioma.
   */
  versions Json
  /**
   * O paragrafo em portugues que compara os quatro idiomas neste texto.
   */
  contrast String

  timesUsed  Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([topicId, level])
  @@map("reading_passages")
}

// ============================ Can-do (4 idiomas) ============================

/**
 * A aula de uma can-do: a MESMA frase realizada nos quatro idiomas.
 * `SentencePattern` nao serve para isto e nao da para adaptar: ela e chaveada
 * por (idioma, nivel, padrao) e guarda a aula de UM idioma. Uma aula de can-do
 * nao pertence a idioma nenhum -- ela existe justamente no espaco entre os
 * quatro, e quebra-la em quatro linhas perderia o unico dado que importa: que
 * aquelas frases sao a mesma frase.
 * Gerada fora do horario de estudo, como todo pool -- esta e a geracao mais
 * cara do produto (quatro idiomas numa resposta so, com cirilico dentro).
 */
model CanDoLesson {
  id        String @id @default(uuid())
  /**
   * Id da can-do no catalogo do codigo, ex.: "dizer-onde-algo-esta".
   */
  canDoId   String
  /**
   * O nivel-teto da aula: o MENOR nivel entre os idiomas do aluno, porque a
   * can-do precisa ser ensinavel nos quatro ao mesmo tempo.
   */
  level     String
  /**
   * A pergunta da can-do, em portugues, como o aluno a formularia.
   */
  question  String
  /**
   * As colunas da tabela de montagem. As mesmas nos quatro idiomas.
   */
  columns   Json
  /**
   * As frases-modelo, cada uma com as suas realizacoes por idioma, ja
   * fatiadas nas colunas.
   */
  sentences Json
  /**
   * O paragrafo em portugues que compara os quatro idiomas nesta funcao.
   */
  contrast  String

  timesUsed  Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([canDoId, level])
  @@map("can_do_lessons")
}
