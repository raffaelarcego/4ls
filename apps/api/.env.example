# ---------- Banco de dados ----------
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/raffael4l?schema=public"

# ---------- Auth ----------
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="30d"

# ---------- Servidor ----------
PORT=3333
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# ---------- IA: ordem de fallback (mimo -> openrouter) ----------
AI_PROVIDER_ORDER="mimo,openrouter"

# ---------- Xiaomi MiMo ----------
MIMO_API_KEY=""
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_STRONG_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_FAST_MODEL="openai/gpt-4o-mini"

# ---------- Voz (TTS/ASR) ----------
# Sem nenhuma chave aqui o sistema continua funcionando: o front cai na voz
# sintetica do proprio navegador e, no Speaking Lab, no reconhecimento de fala
# do navegador (Chrome/Edge). Preencher so troca a qualidade, nao habilita a
# funcionalidade.
SPEECH_PROVIDER_ORDER="openai,elevenlabs"

# Rotas /audio/speech e /audio/transcriptions no formato da OpenAI.
# E o unico provider que faz as duas pontas: falar e transcrever.
SPEECH_API_KEY=""
SPEECH_BASE_URL="https://api.openai.com/v1"
SPEECH_TTS_MODEL="gpt-4o-mini-tts"
SPEECH_STT_MODEL="whisper-1"
SPEECH_VOICE_EN="alloy"
SPEECH_VOICE_ES="nova"
SPEECH_VOICE_DE="onyx"

# ElevenLabs so sintetiza (nao transcreve), mas com timbre bem mais natural.
ELEVENLABS_API_KEY=""
ELEVENLABS_BASE_URL="https://api.elevenlabs.io/v1"
ELEVENLABS_MODEL="eleven_multilingual_v2"
ELEVENLABS_VOICE=""
ELEVENLABS_VOICE_EN=""
ELEVENLABS_VOICE_ES=""
ELEVENLABS_VOICE_DE=""
