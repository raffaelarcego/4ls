# ---------- Banco de dados ----------
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/raffael4l?schema=public"

# ---------- Auth ----------
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="30d"

# ---------- Servidor ----------
PORT=3333
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# ---------- IA: ordem de fallback (mimo -> openrouter) ----------
AI_PROVIDER_ORDER="mimo,openrouter"

# ---------- Xiaomi MiMo ----------
MIMO_API_KEY=""
MIMO_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_STRONG_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_FAST_MODEL="openai/gpt-4o-mini"

# ---------- Voz (TTS/ASR) ----------
# Sem nenhuma chave aqui o sistema continua funcionando: o front cai na voz
# sintetica do proprio navegador e, no Speaking Lab, no reconhecimento de fala
# do navegador (Chrome/Edge). Preencher so troca a qualidade, nao habilita a
# funcionalidade.
SPEECH_PROVIDER_ORDER="mimo,openai,elevenlabs"

# ---------- MiMo (voz) ----------
# Usa a MESMA chave do texto (MIMO_API_KEY acima). Se ela ja esta preenchida,
# a voz natural funciona sem configurar mais nada.
#
# A MiMo nao expoe /audio/speech: TTS e ASR passam pelo /chat/completions, com
# o texto a falar numa mensagem "assistant" e o estilo numa mensagem "user".
MIMO_TTS_MODEL="mimo-v2.5-tts"
MIMO_TTS_STYLE=""                # instrucao de estilo; vazio usa o padrao didatico
MIMO_VOICE_EN="Mia"              # vozes: Mia, Chloe, Milo, Dean, e as chinesas
MIMO_VOICE_ES="Chloe"
MIMO_VOICE_DE="Dean"

# ASR da MiMo: DESLIGADO por padrao (lista vazia), por dois motivos medidos --
# fora do ingles a transcricao sai corrompida, e o navegador grava em webm,
# que a MiMo nao aceita. Com audio wav e so ingles, da para habilitar:
MIMO_ASR_MODEL="mimo-v2.5-asr"
MIMO_ASR_LANGUAGES=""            # ex.: "en"
MIMO_ASR_FORMATS="wav,mp3,m4a,mp4"

# Rotas /audio/speech e /audio/transcriptions no formato da OpenAI.
# E o unico provider que faz as duas pontas: falar e transcrever.
SPEECH_API_KEY=""
SPEECH_BASE_URL="https://api.openai.com/v1"
SPEECH_TTS_MODEL="gpt-4o-mini-tts"
SPEECH_STT_MODEL="whisper-1"
SPEECH_VOICE_EN="alloy"
SPEECH_VOICE_ES="nova"
SPEECH_VOICE_DE="onyx"

# ElevenLabs so sintetiza (nao transcreve), mas com timbre bem mais natural.
ELEVENLABS_API_KEY=""
ELEVENLABS_BASE_URL="https://api.elevenlabs.io/v1"
ELEVENLABS_MODEL="eleven_multilingual_v2"
ELEVENLABS_VOICE=""
ELEVENLABS_VOICE_EN=""
ELEVENLABS_VOICE_ES=""
ELEVENLABS_VOICE_DE=""
